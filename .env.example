# Atlassian Cloud credentials
ATLASSIAN_DOMAIN=yoursite.atlassian.net
ATLASSIAN_EMAIL=admin@example.com
ATLASSIAN_API_TOKEN=your-api-token-here

# Supabase — new key format (Dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # public key, safe for frontend
SUPABASE_SECRET_KEY=sb_secret_xxx             # backend only, bypasses RLS

# Application settings
DEBUG=false
SYNC_INTERVAL_MINUTES=60

# Auth
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
